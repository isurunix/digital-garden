year = {2020},
url = {https://www.semanticscholar.org/paper/656d71ed7d91a1a73b605f9cba627b93079a2531},
abstract = {The use of the internet has increased a lot in the last decade. As a result, now-a-days everything is moving to the digital world. The Digital Revolution is the shift from mechanical and analogue electronic technology to digital electronics. The main aim of this project is to develop a user friendly and inexpensive method for managing monthly home expenditure. The objective is to remove the traditional practise of using the expense management of keeping track of all the bills and expenses and automate this process using Robotic Process Automation (RPA). Human errors can be reduced by automating the process of expense management. A diagrammatic representation of the expenses incurred during a certain time can be created on the basis of the expenses extracted from the bills through Rossum Elis.},
author = {Abhay Gupta and Dhruv Oza and Tejas Manikwar and Prashant Sawant},
journal = {Other Information Systems & eBusiness eJournal},
volume = {null},
pages = {null},
doi = {10.2139/ssrn.3564643},
}

@article{dfa24cc5486def61b43c8c80fd518cee8232fb6b,
title = {MONEYMINDER - A GUIDE TO FINANCIAL CLARITY},
year = {null},
url = {https://www.semanticscholar.org/paper/dfa24cc5486def61b43c8c80fd518cee8232fb6b},
abstract = {: The project's goal is to create a productive web-based application for tracking expenses that classifies expenses using a BERT model. With the help of this application, users can effortlessly track, organise, and evaluate their spending. The intuitive interface facilitates effortless data entry and expense management, and private is protected by safe authentication procedures. Insights into spending trends and budget allocations are provided by advanced features like summaries of expenses, data visualization, and customizable categories. With an emphasis on integrating the BERT model for expense categorization, the report goes into detail about the development process, covering system architecture, design methodologies, implementation strategies, and technology utilization. It places a strong emphasis on responsiveness across various devices, usability, and accessibility. The report also looks at future prospects and possible improvements, with the goal of leveraging the BERT model to further enhance the application's features and capabilities. By effectively classifying and analyzing expenses, the expense tracker web application not only helps with expense management but also encourages responsible financial behaviour and financial literacy.},
author = {Adithya P Patel and Gokul and B. E. Student},
}

