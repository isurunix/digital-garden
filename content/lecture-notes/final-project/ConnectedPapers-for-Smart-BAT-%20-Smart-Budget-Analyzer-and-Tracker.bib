@article{89961092a79e718d5d28d8c64b324ef28cdabed5,
title = {Smart BAT - Smart Budget Analyzer and Tracker},
year = {2023},
url = {https://www.semanticscholar.org/paper/89961092a79e718d5d28d8c64b324ef28cdabed5},
abstract = {Maintaining your daily expenses manually by entering all the details of the items purchased can often feel like an intimidating task. This research discusses the difficulties in budget tracking and suggests a fresh budget tracking program to simplify difficulties such as maintaining the expenses manually using pen and paper, spreadsheet or a diary. Departing from these traditional manual approaches the authors have proposed an innovative solution for this tedious task. In this research paper, we have proposed an automated system that combines Optical Character Recognition and Machine Learning to tackle the challenges associated with transforming physical bills into digital format. The key feature of the application includes optical character recognition which will scan the bill and extract all the items present on the bill and automatically categorize the items into various categories where the item belongs. The application also provides some additional features such as future expense prediction and a detailed report generation. In this study, authors emphasizes the significance of effective budget tracking in the modern world and offers a creative solution by creating a user-centered budget tracking application. We hope that by meeting the needs of the average customer and providing a flawless experience, our application can considerably enhance people’s financial well-being.},
author = {Sahil Shelke and Manish Shingre and Sahaya Lebisha and Shainila Shaikh},
journal = {2023 International Conference on Advanced Computing Technologies and Applications (ICACTA)},
volume = {null},
pages = {1-5},
doi = {10.1109/ICACTA58201.2023.10392452},
}

@article{ed59c403e05daa894932cc0fa61ed6c74c7cf1dd,
title = {Financial and Individual Future Expense Prediction Based on Frequent Patterns Using Micro Services},
year = {2022},
url = {https://www.semanticscholar.org/paper/ed59c403e05daa894932cc0fa61ed6c74c7cf1dd},
abstract = {Consumers have a wealth of offerings and productive alternatives to choose from in today's world. As a result, people's prices have skyrocketed in contrast to a decade before, and the cost of living continues to rise every day. Therefore, to lead a fantastic lifestyle with the correct price range set up, it will become necessary to keep a close eye on costs. Users can track their prices in terms of bar graphs, pie charts, and summaries on a day-to-day or weekly, or even monthly/ yearly basis with this software. The given utility is both net and cellular, a complete specified expense tracker device with a view to no longer only help users maintain a take a look at their fees, but additionally cut down the unrequited fees, and as a result, will help offer a responsible way of life. An evaluation comparing the current price tracker and the existing tracker applications was established. The mobile application was created to help users keep track of their expenses and decide whether they are spending within their budget. While the expense was created, potential users needed to enter the desired information, including the price amount, service provider, category, and date. Optional records, such as sub-classes and additional rate remarks, can also be entered. A monitoring software program with the one being added is provided. Penny, the Expense Tracker.},
author = {Dr. A. Tamizhselvi and Dr. M. Anbu and Mr. K. R.Radhakrishnan},
journal = {2022 Third International Conference on Intelligent Computing Instrumentation and Control Technologies (ICICICT)},
volume = {null},
pages = {532-536},
doi = {10.1109/ICICICT54557.2022.9917982},
}

@article{3a294ccde4774f7aaf0b87f513f0e8b697fbd896,
title = {Unveiling Financial Insights: The Daily Expense Tracker System Approach},
year = {2024},
url = {https://www.semanticscholar.org/paper/3a294ccde4774f7aaf0b87f513f0e8b697fbd896},
abstract = {The Daily Expense Tracker System, a safe and intuitive platform designed to satisfy the changing needs of people and businesses in handling daily expenses, is presented in this study. The system has an easy-to-use interface, provides thorough insights into monthly spending trends, and enables customized reporting to improve financial transparency. It was created in response to the changing financial environment and serves consumers looking for a dependable and user-friendly spending tracking solution. By bridging the gap between user expectations and current solutions, the research project hopes to enable users to make informed financial decisions. The system offers a revolutionary approach to financial tracking, going beyond typical spending management with its customizable dashboards and cutting-edge capabilities. In keeping with the evolving digital banking scene, the system emphasizes how crucial thorough spending tracking is in the linked world of today. The study adds a great deal to the conversation about efficient expense management by giving consumers access to a tool that tracks spending, promotes wise decision-making, and improves overall financial efficiency.},
author = {Sanjay Singla and Amanpreet Kaur and Anju and Aditya Soni and Rajiv Dhaiya and G. Kaur},
journal = {2024 International Conference on Emerging Innovations and Advanced Computing (INNOCOMP)},
volume = {null},
pages = {448-453},
doi = {10.1109/INNOCOMP63224.2024.00079},
}

