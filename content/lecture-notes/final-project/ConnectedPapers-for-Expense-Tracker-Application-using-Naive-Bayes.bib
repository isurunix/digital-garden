}

@article{a610dbbb02e45bc56aed517d179fb6562bca5b38,
title = {Machine learning analysis of shear stress over a symmetrically stenosed arterial wall under the impact of magnetic field},
year = {2023},
url = {https://www.semanticscholar.org/paper/a610dbbb02e45bc56aed517d179fb6562bca5b38},
abstract = {This study provides a framework to predict the shear stress over a symmetrically stenosed arterial wall under the impact of magnetic field using machine learning algorithms. We investigated the magnetohydrodynamics blood flow with the help of machine learning techniques. The considered model is governed by the principles of MHD. To predict the flow patterns and velocity of the blood flow it is important to study the relationship between the blood shear stress rate with the six blood flow input variables: flow rate (q), viscosity, radius (r), height(h), pressure (P) and velocity (v). We presented the correlation graph of shear stress with the six blood flow input variables. The machine learning models (CatBoost regressor, Random Forest regressor, Regressor tree, MLP regressor and Lasso model) were used to validate the dataset. Radar graphs have been plotted to visualize and compare the accuracy measured for all the five machine learning models. Our conclusion pretends that the random forest regressor analyze this problem accurately with noise free data.},
author = {Spurthi Joanna Selladurai and N. Srivastava and P. Pati},
journal = {2023 2nd International Conference on Vision Towards Emerging Trends in Communication and Networking Technologies (ViTECoN)},
volume = {null},
pages = {1-5},
doi = {10.1109/ViTECoN58111.2023.10157351},
}

@article{1f0bb225ef384204945500de93fd314e38109d1d,
title = {Email Spam Monitoring System},
year = {2024},
url = {https://www.semanticscholar.org/paper/1f0bb225ef384204945500de93fd314e38109d1d},
abstract = {Emails are extremely important in business and other forms of communication, and they have been recognized as one of the most significant and extensively utilized forms of communication in contemporary times. They have evolved into a convenient means of disseminating information. Being on the Internet makes you vulnerable to attacks, and emails are no exception. And emails are more vulnerable as compared to other sources, as the user can be a victim of cyber-attacks like phishing, spamming, ransomware, malware injection, etc. using email. So, to detect and inspect such suspicious emails, we have develop an Email Monitoring System that will detect such emails based on defined parameters and convictions and on some suspicious keywords such as hijacking, explosion, etc. Attackers commonly use email phishing and spamming as they are the simplest methods to deceive someone and trick them into clicking on a malicious link through an email that appears authentic. These emails are used to breach a computer’s defense systems. The malicious links shared within the email are designed to mimic the spoofed organization by utilizing their logos and legitimate content. In this article, we will explain the distinguishing characteristics of fraudulent emails, why it is crucial to detect them, and how machine learning techniques and models with an alleged algorithm can be used to identify them within an email message.},
author = {Mayank Srivastava and Dhruv Khandelwal and Navya Swarup},
journal = {2023 4th International Conference on Intelligent Technologies (CONIT)},
volume = {null},
pages = {1-7},
doi = {10.1109/CONIT61985.2024.10626718},
}

